# Sao chép thành deploy/env.server trên server và điền mật khẩu:
#   cp deploy/env.server.example deploy/env.server
#   sudo bash deploy/setup-admin-env.sh
#
# Hoặc tạo tự động (khuyến nghị):
#   sudo bash deploy/setup-admin-env.sh

APP_ROOT=/opt/TrienLam_LanhDao_v2
APP_PORT=5007
APP_IMAGE=trienlam-lanhdao2:latest

# Bắt buộc cho đăng nhập /admin1111 (tối thiểu 6 và 16 ký tự)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
